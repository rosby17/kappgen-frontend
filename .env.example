# Backend API URL. Leave unset for local dev (defaults to http://localhost:8000).
# For a deployed frontend (Cloudflare Pages, Vercel...), set these to the deployed
# backend's public URL, e.g.:
# VITE_API_BASE=https://your-backend-domain/api
# VITE_STORAGE_BASE=https://your-backend-domain/storage
VITE_API_BASE=
VITE_STORAGE_BASE=
VITE_APP_ORIGIN=https://app.kappgen.com
VITE_MARKETING_ORIGIN=https://kappgen.com
